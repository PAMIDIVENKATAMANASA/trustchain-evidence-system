# Server Environment Variables
# Copy to .env and fill in your values

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/trustchain

# JWT secret for authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Pinata IPFS credentials (https://pinata.cloud)
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key
PINATA_JWT=your_pinata_jwt_token

# Blockchain RPC URL (Sepolia testnet)
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Deployer wallet private key (MetaMask → Export Private Key)
# WARNING: Never commit .env to git!
PRIVATE_KEY=your_wallet_private_key_here

# Optional: default collector address if officer has no wallet
DEFAULT_COLLECTOR_ADDRESS=0xa0692D0E323D2C6A192392550F1CE0EaaCC6a741

# Server port
PORT=5000
